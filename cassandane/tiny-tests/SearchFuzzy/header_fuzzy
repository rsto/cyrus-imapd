#!perl
use Cassandane::Tiny;

sub test_header_fuzzy
    ($self)
{
    my $talk = $self->{store}->get_client();

    $self->make_message("running fast",
        extra_headers => [ [ 'X-Nice-Day-For', 'running fast' ] ]) || die;
    $self->make_message("walking slowly") || die;
    $self->{instance}->run_command({cyrus => 1}, 'squatter', '-i');

    xlog $self, "the dedicated SUBJECT key matches a stemmed variant";
    my $uids = $talk->search('fuzzy', 'subject', 'runs');
    $self->assert_deep_equals([1], $uids);

    xlog $self, "HEADER Subject must match the same content the same way, not fall back to a substring scan";
    $uids = $talk->search('fuzzy', 'header', 'subject', 'runs');
    $self->assert_deep_equals([1], $uids);

    xlog $self, "a header field with no search attribute keeps substring semantics: a mid-word substring matches";
    $uids = $talk->search('fuzzy', 'header', 'x-nice-day-for', 'unning');
    $self->assert_deep_equals([1], $uids);

    xlog $self, "and a stemmed variant, which only the fuzzy path could match, does not";
    $uids = $talk->search('fuzzy', 'header', 'x-nice-day-for', 'runs');
    $self->assert_deep_equals([], $uids);
}
